.class public Lzvh;
.super Lzvk;


# direct methods
.method public constructor <init>()V
    .locals 0

    invoke-direct {p0}, Lzvk;-><init>()V

    return-void
.end method

.method public constructor <init>(Lzus;)V
    .locals 0

    invoke-direct {p0, p1}, Lzvk;-><init>(Lzus;)V

    return-void
.end method
