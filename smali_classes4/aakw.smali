.class final Laakw;
.super Laaij;


# static fields
.field static final a:Laorf;


# direct methods
.method static constructor <clinit>()V
    .locals 1

    new-instance v0, Laaii;

    invoke-direct {v0}, Laaii;-><init>()V

    sput-object v0, Laakw;->a:Laorf;

    return-void
.end method

.method public constructor <init>()V
    .locals 0

    invoke-direct {p0}, Laaij;-><init>()V

    return-void
.end method
