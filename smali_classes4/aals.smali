.class final Laals;
.super Laajs;


# static fields
.field static final a:Laorf;

.field static final b:Laorf;


# direct methods
.method static constructor <clinit>()V
    .locals 1

    new-instance v0, Laajp;

    invoke-direct {v0}, Laajp;-><init>()V

    sput-object v0, Laals;->a:Laorf;

    new-instance v0, Laakw;

    invoke-direct {v0}, Laakw;-><init>()V

    sput-object v0, Laals;->b:Laorf;

    return-void
.end method

.method public constructor <init>()V
