.class public Lbsd;
.super Lbsc;


# direct methods
.method public constructor <init>()V
    .locals 0

    invoke-direct {p0}, Lbsc;-><init>()V

    return-void
.end method

.method public constructor <init>(Lbsq;)V
    .locals 0

    invoke-direct {p0, p1}, Lbsc;-><init>(Lbsq;)V

    return-void
.end method
